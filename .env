# =====================================================
# サイトの公開URL（末尾に / は付けない）
# -----------------------------------------------------
# OGP・Twitterカード・構造化データのURLに使われます。
# Vercelで公開したら、実際のURLに書き換えて再デプロイしてください。
# 例: プロジェクト名が shimohara-matsuri の場合
#     → https://shimohara-matsuri.vercel.app
# =====================================================
VITE_SITE_URL=https://shimohara-festival-lp.vercel.app

# =====================================================
# 動画の配信ベースURL（Cloudflare R2 など。末尾に / は付けない）
# -----------------------------------------------------
# 空のままなら、これまで通り public/videos/ 配下の動画を使います。
# R2 にアップロードしたら、発行された公開URLをここに設定してください。
#   例: VITE_MEDIA_BASE_URL=https://pub-xxxxxxxx.r2.dev
# ※ R2 には public/videos/ と同じ videos/festival/... の構造で置くこと。
# ※ Vercel では「Settings → Environment Variables」にも同じ値を登録して再デプロイ。
# =====================================================
VITE_MEDIA_BASE_URL=https://pub-e24c426831364290b09ec74f5b1ddf47.r2.dev
